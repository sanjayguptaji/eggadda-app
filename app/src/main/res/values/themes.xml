<resources>
    <style name="Theme.Eggadda" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/yolk</item>
        <item name="android:navigationBarColor">@color/shell</item>
        <item name="android:windowBackground">@color/shell</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Eggadda.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yolk</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Eggadda</item>
    </style>
</resources>
